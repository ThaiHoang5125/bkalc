{
  "name": "hcmut-gpa",
  "productName": "BKalc",
  "version": "1.0.6",
  "description": "BKalc - ứng dụng tính và lập kế hoạch GPA cho sinh viên HCMUT",
  "author": "Thái Hoàng",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build && electron-builder --win portable zip --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "lock:set": "node scripts/set-lock.cjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "vn.edu.hcmut.gpa.tai",
    "productName": "BKalc",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BKalc-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "afterPack": "scripts/afterPack.cjs"
  }
}
